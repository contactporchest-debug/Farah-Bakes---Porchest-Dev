---
import { Picture } from "astro:assets";
import heroMainImg from "../assets/images/IMG_1605 copy.jpg";

const message = "Hello, I would like to order from Farah Bakes.";
const whatsappNumber = "1234567890";
const whatsappHref = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`;
---

<section class="hero">
  <div class="container hero-container">
    <div class="hero-content">
      <h1>Wholesome Treats, Premium Ingredients And Homemade.</h1>
      <p class="sub-headline">
        Handcrafted with original, imported ingredients and the rich, natural
        warmth of brown sugar for an unforgettable taste.
      </p>
      <a
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-outline">ORDER NOW</a
      >
    </div>

    <div class="hero-visual">
      <div class="image-wrapper">
        <Picture
          src={heroMainImg}
          alt="Cake dusted with sugar"
          formats={["avif", "webp"]}
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background-image: url("../assets/images/hero-img.png");
    background-size: cover;
    background-position: center bottom;
    background-repeat: no-repeat;
    /* background-color: var(--primary-green); */
    padding-top: 8rem;
    padding-bottom: 12rem;
  }

  .hero-container {
    display: flex;
    flex-direction: row;
    align-items: center;
    position: relative;
    z-index: 2;
    gap: 3rem;
  }

  .hero-content {
    flex: 1;
    color: var(--text-light);
  }

  .sub-headline {
    font-size: clamp(1.2rem, 2vw, 1.25rem);
    margin-bottom: 2rem;
    max-width: 90%;
  }

  .hero-visual {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .image-wrapper {
    position: relative;
    width: clamp(15rem, 30vw, 30rem);
    height: clamp(15rem, 30vw, 30rem);
  }

  .image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 100%;
    border: 0.35rem var(--primary-gold) solid;
    position: relative;
    z-index: 2;
  }

  @media (max-width: 992px) {
    .hero-container {
      flex-direction: column;
      text-align: center;
    }

    .hero-content {
      margin-top: 3rem;
    }

    .sub-headline {
      margin: 0 auto 2.5rem;
    }

    .hero {
      padding-top: 6rem;
      padding-bottom: 8rem;
    }
  }
</style>
