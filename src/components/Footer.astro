---
import { Image } from "astro:assets";
import footerLogoImg from "../assets/images/logo-2.png";
---

<footer class="footer">
  <!-- Top SVG Wave Divider (Inverted) -->
  <div class="wave-divider-top">
    <svg viewBox="0 0 1440 160" preserveAspectRatio="none">
      <path
        fill="#FAFAFA"
        fill-opacity="1"
        d="M0,64L48,80C96,96,192,128,288,128C384,128,480,96,576,90.7C672,85,768,107,864,122.7C960,139,1056,149,1152,138.7C1248,128,1344,96,1392,80L1440,64L1440,0L1392,0C1344,0,1248,0,1152,0C1056,0,960,0,864,0C768,0,672,0,576,0C480,0,384,0,288,0C192,0,96,0,48,0L0,0Z"
      ></path>
    </svg>
  </div>

  <div class="container footer-content">
    <div class="footer-grid">
      <div class="footer-col brand-col">
        <Image src={footerLogoImg} alt="Farah Bakes" class="footer-logo" />
        <p class="footer-tagline">Baking sweet memories with every bite.</p>
      </div>

      <!-- <div class="footer-col">
        <h4>Inquiries</h4>
        <a href="#contact">Contact Us</a>
      </div> -->

      <div class="footer-col">
        <h4>Links</h4>
        <a href="#story">Our Story</a>
        <a href="/menu">Menu</a>
      </div>

      <div class="footer-col">
        <h4>Social Media</h4>
        <div class="social-links">
          <a href="#"
            ><img
              src="https://cdn-icons-png.flaticon.com/512/124/124010.png"
              alt="Facebook"
              class="social-icon"
            /> Facebook</a
          >
          <a href="#"
            ><img
              src="https://cdn-icons-png.flaticon.com/512/174/174855.png"
              alt="Instagram"
              class="social-icon"
            /> Instagram</a
          >
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; 2026 Farah Bakes</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--primary-green);
    color: var(--text-light);
    position: relative;
    padding-top: clamp(10rem, 15vw, 14rem);
  }

  .wave-divider-top {
    position: absolute;
    top: -1px;
    left: 0;
    width: 100%;
    line-height: 0;
    z-index: 3;
  }

  .wave-divider-top svg {
    display: block;
    width: 100%;
    height: clamp(50px, 10vw, 160px);
  }

  .footer-content {
    position: relative;
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr repeat(3, 1fr);
    gap: 3rem;
    width: 100%;
    max-width: 1000px;
    margin-bottom: 4rem;
    text-align: left;
  }

  .footer-logo {
    max-width: 150px;
    height: auto;
    /* margin-bottom: 1rem; */
  }

  .footer-tagline {
    color: #e0e0e0;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .footer-col h4 {
    color: var(--primary-gold);
    margin-bottom: 1.5rem;
  }

  .footer-col a {
    display: block;
    color: #e0e0e0;
    margin-bottom: 0.8rem;
    font-size: 0.95rem;
  }

  .footer-col a:hover {
    color: var(--primary-gold);
  }

  .social-links a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  @media (max-width: 768px) {
    .social-links a {
      justify-content: center;
    }
  }

  .social-icon {
    width: 1.2rem;
    height: 1.2rem;
    filter: brightness(0) invert(1);
  }

  .footer-bottom {
    width: 100%;
    text-align: center;
    padding: 2rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .footer-bottom p {
    margin: 0;
    font-size: 0.85rem;
    color: #a0a0a0;
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      text-align: center;
    }
    .brand-col {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
  }
</style>
