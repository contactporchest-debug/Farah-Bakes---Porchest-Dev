---
import { Image } from "astro:assets";
import logoImg from "../assets/images/logo-2.png";

const pathname = Astro.url.pathname;
const isHome = pathname === "/" || pathname === "/index.html";

const message = "Hello, I would like to order from Farah Bakes.";
const whatsappNumber = "1234567890";
const whatsappHref = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`;
---

<header class={`header ${isHome ? "header-transparent" : ""}`}>
  <div class="container header-content">
    <div class="logo">
      <a href="/">
        <Image
          src={logoImg}
          alt="Farah Bakes Logo"
          class="logo-img"
          loading="eager"
          fetchpriority="high"
        />
      </a>
    </div>

    <button
      class="hamburger-btn"
      aria-label="Toggle Menu"
      aria-expanded="false"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav class="nav-links">
      <a href="/menu">Menu</a>
      <a
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary">Order Now</a
      >
    </nav>
  </div>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    const hamburgerBtn = document.querySelector(".hamburger-btn");
    const navLinks = document.querySelector(".nav-links");
    const body = document.querySelector("body");
    const links = document.querySelectorAll(".nav-links a");

    if (hamburgerBtn && navLinks) {
      hamburgerBtn.addEventListener("click", () => {
        const isExpanded =
          hamburgerBtn.getAttribute("aria-expanded") === "true";
        hamburgerBtn.setAttribute("aria-expanded", (!isExpanded).toString());
        navLinks.classList.toggle("active");
        if (!isExpanded) {
          body.style.overflow = "hidden";
        } else {
          body.style.overflow = "";
        }
      });

      links.forEach((link) => {
        link.addEventListener("click", () => {
          hamburgerBtn.setAttribute("aria-expanded", "false");
          navLinks.classList.remove("active");
          body.style.overflow = "";
        });
      });
    }
  });

  // Fallback for non-view-transitions mode
  const setupMenu = () => {
    const hamburgerBtn = document.querySelector(".hamburger-btn");
    const navLinks = document.querySelector(".nav-links");
    const body = document.querySelector("body");
    const links = document.querySelectorAll(".nav-links a");

    if (
      hamburgerBtn &&
      navLinks &&
      !hamburgerBtn.hasAttribute("data-initialized")
    ) {
      hamburgerBtn.setAttribute("data-initialized", "true");
      hamburgerBtn.addEventListener("click", () => {
        const isExpanded =
          hamburgerBtn.getAttribute("aria-expanded") === "true";
        hamburgerBtn.setAttribute("aria-expanded", (!isExpanded).toString());
        navLinks.classList.toggle("active");
        if (!isExpanded) {
          body.style.overflow = "hidden";
        } else {
          body.style.overflow = "";
        }
      });

      links.forEach((link) => {
        link.addEventListener("click", () => {
          hamburgerBtn.setAttribute("aria-expanded", "false");
          navLinks.classList.remove("active");
          body.style.overflow = "";
        });
      });
    }
  };

  setupMenu();
</script>

<style>
  .header {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    padding: 1rem 0;
    background-color: var(--primary-green);
    border-radius: 0 0 3rem 3rem;
  }

  .header.header-transparent {
    background-color: transparent;
  }

  .header-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo-img {
    height: 4rem;
    width: auto;
    transition: height 0.3s ease;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-links a:not(.btn) {
    color: var(--text-light);
    font-weight: 500;
  }

  .nav-links a:not(.btn):hover {
    color: var(--primary-gold);
  }

  .hamburger-btn {
    display: none;
    position: relative;
    width: 30px;
    height: 24px;
    background: transparent;
    border: none;
    cursor: pointer;
    z-index: 101;
    padding: 0;
  }

  .hamburger-btn span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 3px;
    background-color: var(--text-light);
    border-radius: 10px;
    transition: all 0.3s ease-in-out;
  }

  .hamburger-btn span:nth-child(1) {
    top: 0;
  }

  .hamburger-btn span:nth-child(2) {
    top: 50%;
    transform: translateY(-50%);
  }

  .hamburger-btn span:nth-child(3) {
    bottom: 0;
  }

  /* Hamburger Animation */
  .hamburger-btn[aria-expanded="true"] span:nth-child(1) {
    top: 50%;
    transform: translateY(-50%) rotate(45deg);
  }
  .hamburger-btn[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }
  .hamburger-btn[aria-expanded="true"] span:nth-child(3) {
    bottom: 50%;
    transform: translateY(50%) rotate(-45deg);
  }

  @media (max-width: 768px) {
    .logo-img {
      height: 2.5rem;
    }

    .hamburger-btn {
      display: block;
    }

    .nav-links {
      position: fixed;
      top: 0;
      right: 0;
      transform: translateX(100%);
      width: 100vw;
      height: 100vh;
      background-color: rgba(
        30,
        61,
        47,
        0.98
      ); /* var(--primary-green) with opacity */
      flex-direction: column;
      justify-content: center;
      align-items: center;
      transition: transform 0.3s ease-in-out;
      z-index: 100;
      gap: 3rem;
    }

    .nav-links.active {
      transform: translateX(0);
    }

    .nav-links a:not(.btn) {
      display: block;
      font-size: 2rem;
    }

    .nav-links .btn {
      font-size: 1.5rem;
      padding: 1rem 2rem;
    }
  }
</style>
